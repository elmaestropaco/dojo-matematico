{
  "rules": {
    ".read": false,
    ".write": false,
    "secureRooms": {
      "$room": {
        ".read": "auth !== null && data.child('schemaVersion').val() === 2 && (data.child('hostUid').val() === auth.uid || (data.child('expiresAt').val() > now && data.child('players').child(auth.uid).exists() && !data.child('blocked').child(auth.uid).exists()))",
        ".write": "auth !== null && $room.matches(/^[A-Z2-9]{8}$/) && ((!data.exists() && newData.exists() && newData.child('hostUid').val() === auth.uid && newData.child('schemaVersion').val() === 2 && newData.child('status').val() === 'lobby' && !newData.child('players').exists() && !newData.child('blocked').exists()) || (data.child('schemaVersion').val() === 2 && data.child('hostUid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['schemaVersion', 'hostUid', 'mode', 'status', 'seed', 'durationSeconds', 'hostName', 'config', 'createdAt', 'expiresAt']) && (!data.exists() || (newData.child('hostUid').val() === data.child('hostUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
        "schemaVersion": {
          ".validate": "newData.val() === 2"
        },
        "hostUid": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "mode": {
          ".validate": "newData.val() === 'teacher' || newData.val() === 'duel_online'"
        },
        "status": {
          ".validate": "newData.val() === 'lobby' || newData.val() === 'running' || newData.val() === 'finished'"
        },
        "seed": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2147483646 && newData.val() % 1 === 0"
        },
        "durationSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400 && newData.val() % 1 === 0"
        },
        "hostName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "config": {
          ".validate": "newData.isString() && newData.val().length <= 24000"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 120000"
        },
        "startedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 120000"
        },
        "rematchAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 120000"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000"
        },
        "blocked": {
          "$uid": {
            ".validate": "newData.val() === true"
          }
        },
        "players": {
          "$uid": {
            ".read": "auth !== null && $uid === auth.uid && root.child('secureRooms').child($room).child('schemaVersion').val() === 2 && root.child('secureRooms').child($room).child('expiresAt').val() > now && !root.child('secureRooms').child($room).child('blocked').child(auth.uid).exists()",
            ".write": "auth !== null && $uid === auth.uid && newData.exists() && root.child('secureRooms').child($room).child('schemaVersion').val() === 2 && root.child('secureRooms').child($room).child('expiresAt').val() > now && !root.child('secureRooms').child($room).child('blocked').child(auth.uid).exists() && (data.exists() || ((root.child('secureRooms').child($room).child('status').val() === 'lobby' || root.child('secureRooms').child($room).child('status').val() === 'running') && newData.child('score').val() === 0 && newData.child('streak').val() === 0 && newData.child('operationIndex').val() === 0 && newData.child('correctCount').val() === 0 && newData.child('wrongCount').val() === 0 && newData.child('resolvedCount').val() === 0 && newData.child('roundSeed').val() === 0 && newData.child('isConnected').val() === true && newData.child('isFinished').val() === false && !newData.child('learningStatsJSON').exists() && !newData.child('pendingFollowUpFrom').exists() && !newData.child('lastAnswer').exists() && !newData.child('lastResult').exists() && !newData.child('lastActionAt').exists()))",
            ".validate": "newData.hasChildren(['name', 'score', 'streak', 'operationIndex', 'correctCount', 'wrongCount', 'resolvedCount', 'roundSeed', 'isConnected', 'isFinished', 'lastSeenAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0"
            },
            "streak": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
            },
            "operationIndex": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
            },
            "correctCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
            },
            "wrongCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
            },
            "resolvedCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
            },
            "roundSeed": {
              ".validate": "newData.isNumber() && ((!data.parent().exists() && newData.val() === 0) || newData.val() === newData.parent().parent().parent().child('seed').val())"
            },
            "isConnected": {
              ".validate": "newData.isBoolean()"
            },
            "isFinished": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeenAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 120000"
            },
            "lastActionAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 120000"
            },
            "lastAnswer": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "lastResult": {
              ".validate": "newData.isString() && newData.val().matches(/^(correct|wrong|skip|solution|hint|finished|left)$/)"
            },
            "learningStatsJSON": {
              ".validate": "newData.isString() && newData.val().length <= 16000"
            },
            "pendingFollowUpFrom": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
